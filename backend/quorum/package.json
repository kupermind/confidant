{
  "name": "confidant-quorum",
  "private": true,
  "type": "module",
  "description": "Confidant quorum services: signer sidecars (hold the XRPL keys, sign only after their own verifier node endorsed) and the coordinator (fans out, assembles k-of-N multisig, submits anchors and payouts). xrpl.js owns every XRPL transaction; the Rust node only reads the ledger.",
  "scripts": {
    "smoke": "node smoke.mjs",
    "smoke-ui": "node smoke-ui.mjs",
    "prepopulate": "node prepopulate.mjs",
    "log:snapshot": "node log-snapshot.mjs",
    "snapshot:verify": "node verify-snapshot.mjs",
    "credential:check": "node credential-check.mjs",
    "pof:check": "node pof-check.mjs",
    "screening:fetch-ofac": "node screening/fetch-ofac.mjs",
    "screening:audit": "node screening/audit.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "signer": "node signer.mjs",
    "coordinator": "node coordinator.mjs",
    "setup-pool": "node setup-pool.mjs",
    "start-all": "node start-all.mjs"
  },
  "dependencies": {
    "xrpl": "^5.3.0"
  },
  "devDependencies": {
    "node": "^22.12.0"
  }
}
