# Copy to .env (gitignored). Keys never go into git, logs or chat.
AP4M_API_URL=https://hackathon.ap4m.build
TEAM_NAME=            # the registered team name (portal)
AGENT_PRIVATE_KEY=    # Agent wallet (EVM EOA) registered on My setup; needs XRP for gas
MERCHANT_ID=          # portal → My setup (or GET /public/participant/me)
MERCHANT_PAYOUT=      # the payout wallet address registered on My setup (receives RLUSD)
MERCHANT_SUBMITTER_KEY=   # a wallet with XRP for gas that redeems vouchers (the payout wallet's key works)
CHANNEL_ID=           # optional: an open Channel; empty → the agent opens one with CHANNEL_CAP
CHANNEL_CAP=2            # demo: 0.15 so the second relay (OVER_CAP_DEMO=1) is refused by the funded cap
OVER_CAP_DEMO=0
PRICE_RLUSD=0.1
MAX_PRICE_RLUSD=0.25
PORT=4308
RELAY_PORT=4309
RESOURCE_URL=http://127.0.0.1:4308/resource   # against the demo host's relay: https://confidant.im/resource
RELAY_URL=http://127.0.0.1:4309               # the relay's origin (the agent appends /relay/transfer): https://confidant.im on stage
COORDINATOR_URL=http://127.0.0.1:7900
ISSUER_URL=            # prepare-wallet: the pool's demo issuer service; empty → the coordinator's origin + /issuer (https://confidant.im/issuer)
CLI=../../target/release/examples/cli
WALLET_FILE=./agent-state/agent.wallet.json
SUPPLIER=             # the supplier's Orchard address (86 hex chars)
AMOUNT=1000000        # drops to transfer privately
STATE_DIRECTORY=./agent-state      # the agent's state (wallet files, log, pending run)
RELAY_STATE_DIRECTORY=./relay-state  # the relay's state (the kit's merchant store, the spent-claims set)

# Proof of funds (machine-to-machine underwriting) and receipts
POF=1                  # agent: prove shielded funds to the quorum before paying (0 skips it; the relay then refuses)
MIN_POF_XRP=1          # relay: serve only an agent whose proof-of-funds credential says controlled ≥ this many XRP
MERCHANT_PAYOUT_KEY=   # relay: the key of MERCHANT_PAYOUT — signs the receipts (the address the 402 names as payTo)
