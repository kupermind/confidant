# Copy to .env (gitignored). Keys never go into git, logs or chat.
AP4M_API_URL=https://hackathon.ap4m.build
TEAM_NAME=            # the registered team name (portal)
AGENT_PRIVATE_KEY=    # Agent wallet (EVM EOA) registered on My setup; needs XRP for gas
MERCHANT_ID=          # portal → My setup (or GET /public/participant/me)
MERCHANT_PAYOUT=      # the payout wallet address registered on My setup (receives RLUSD)
MERCHANT_SUBMITTER_KEY=   # a wallet with XRP for gas that redeems vouchers (the payout wallet's key works)
CHANNEL_ID=           # optional: an open Channel; empty → the agent opens one with CHANNEL_CAP
CHANNEL_CAP=2
PRICE_RLUSD=0.1
MAX_PRICE_RLUSD=0.25
PORT=4308
RELAY_PORT=4309
RESOURCE_URL=http://127.0.0.1:4308/resource   # public HTTPS URL when the agent runs elsewhere
RELAY_URL=http://127.0.0.1:4309
COORDINATOR_URL=http://127.0.0.1:7900
CLI=../../target/release/examples/cli
WALLET_FILE=./agent-state/agent.wallet.json
SUPPLIER=             # the supplier's Orchard address (86 hex chars)
AMOUNT=1000000        # drops to transfer privately
STATE_DIRECTORY=./agent-state
